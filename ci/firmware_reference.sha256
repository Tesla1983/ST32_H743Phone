# ============================================================================
# 第二十二版（2026-10-11）—— 上游 SPP 诊断回流（$BS 帧），本次只加观测、不改业务语义
# ----------------------------------------------------------------------------
# 一、为什么加它
#   手机"发送一直失败"时，既有诊断量**分不清两种故障**：
#     opens==0 ⇒ 手机压根没连上 SPP（安全级/配对/App 用不安全 socket）
#     opens>0 而 rx 小 ⇒ 连上了但数据没发出来
#   而 g_spp_* 只活在 ESP32 上，读 ESP32 串口日志**必然复位**并清零这些计数，
#   永远抓不到现场 ⇒ 只能回送到本板，之后用 SWD 读（SWD 不动 ESP32）。
#
# 二、改动
#   对端 main/uplink_cmd.c：btf_status_broadcast() 推 $BT 之后附带推一帧
#     $BS,<opens>,<closes>,<rx>,<last>,<err>,<run>,<conn>
#     （run = SPP 服务端是否在监听，conn = 手机当前是否连着）
#   本仓库 src/uart_link.c/.h：解析 $BS → g_spp_*_m 镜像量。
#     ⚠ 紧跟 $BT 之后判：两者都是 'B' 开头，靠第二个字符 'T'/'S' 区分。
#
# 三、验收（已验）
#   STM32：SWD 触发 g_bt_recv_req=1 跑 TEST 会话（224×152 BMP）⇒
#     g_bt_bytes=102710 / g_bt_chunks=50 / g_bt_err=0 / g_bt_imp_rc=0（导入成功）
#     / g_net_bt_pkts=51（$BT 在推 ⇒ 同一处推的 $BS 必然也在推）
#     ⇒ 下游管道（ESP32→SPI→STM32→落卡→导入相册）**完全健康**，仪表链路活。
#   ⚠ 这同时证明问题在**上游**（手机→ESP32 SPP），不在本板。
#   未验：手机实连 SPP 的 opens/rx 数值（需真手机）。
#
# FLASH 1 644 256 B（78.40%），比第二十一版 +360 B。
# 4753838bbfda10ef9dd0623932065ff1c5c685705485857dcf3832dc3dda013e  ymgui-h743.bin
# 41db686bb9e06e81f6ca528774ec60547f2dd47081c1d2bb7dd5884eda0d0d4a  ymgui-h743.elf

# ============================================================================
# 第二十三版（2026-10-11）—— 裸流兜底收尾 + $BS 扩到 16 字段
# ----------------------------------------------------------------------------
# 一、为什么改（用户实机测过之后的结论，与上版推测不同）
#   仪表读数：g_spp_run_m=1 / conn_m=1 / opens_m=1 / rx_m=53316，
#     g_bt_bytes=53316 / chunks=77 / err=0 ⇒ **手机连上了、53316 字节全到了、
#     本板也全部落卡**；但 g_net_btf_state 停在 2(RECV) 没收尾 ⇒ 用户看到"传送失败"。
#     ⇒ 上一版怀疑的"ESP_SPP_SEC_AUTHENTICATE 太严"**不成立**（opens=1 证明连上了）。
#   决定性测量：相隔 8 s 两次快照 g_spp_rx_m 纹丝不动（手机早发完）、
#     g_bt_get_n 仍在涨（链路活着），而 state 死死停在 2 ⇒ 对端空闲 EOF 判定没生效。
#
# 二、改动
#   ① 本仓库 src/bt_recv.c：**裸流兜底收尾**（让功能真正可用的那一步）
#      新增 s_last_rx（最近一次真正收到字节的时基，在 write_chunk 里更新）
#      + g_bt_idle_max_ms（默认 BT_IDLE_MAX_MS=5000，可写；写 0 关闭）
#      + 判定挂在 poll 的 ⑤ 之后、⑥ 判死之前：
#        s_recv>0 && g_bt_idle_max_ms!=0 && (now_ms - s_last_rx) > g_bt_idle_max_ms ⇒ finish_ok()
#      ⚠ 只能用 s_last_rx、**不能用 s_t0**：s_t0 会被对端每 25 ms 一次的
#        $!RS,BTF,0（"暂时没数据"）刷新 ⇒ 永远年轻 ⇒ STALL(12 s) 永远不触发。
#      ⚠ 5 s 依据：SPP 连续发包间隔毫秒级；留 5 s 给"手机分两次点发送"留余量，
#        且远短于 STALL。等待期（s_recv==0）不受影响，归 g_bt_wait_max_ms 管。
#   ② 本仓库 src/uart_link.c/.h：$BS 扩到 16 字段，新增对端 EOF 逐条否决计数镜像
#      g_eof_run_m / v_state_m / v_size_m / v_recv_m / v_ring_m / v_time_m /
#      g_eof_idle_m / g_eof_fired_m。
#   ③ 对端 main/bt_file.c/.h（非 git 仓库，随本版烧录）：bt_file_eof_check() 内
#      逐条判据加否决计数 + 暴露当前空闲时长 g_eof_idle。
#
# 三、⚠⚠ 本轮最大坑（改动时务必同步）
#   把 $BS 判据从 `nf >= 8` 提到 `nf >= 16` 却忘了扩字段数组：
#     src/uart_link.c 里是 `char* f[8]` + `split_fields(dollar + 1, f, 8)`
#     ⇒ nf 上限只有 8 ⇒ `nf >= 16` **恒为假** ⇒ 分支被判死代码删掉
#     ⇒ 里面的镜像量全成"只写不读" ⇒ 被 -fdata-sections + --gc-sections 回收。
#     表现：**编译通过、零告警，但 arm-none-eabi-nm 查不到符号**（SWD 脚本 KeyError），
#     且 f[8]..f[15] 全是越界访问。
#     `__attribute__((used))` **挡不住** gc-sections（只保证 emit 到 .o）。
#     正解：**字段数门槛与 f[] 数组容量必须一起改**（已改 char* f[16] + split_fields(...,16)）。
#
# 四、验收（已验）
#   SWD 触发 g_bt_recv_req=1 跑 TEST：g_bt_bytes=102399 / chunks=50 / err=0 /
#     imp_rc=0（导入成功）/ done=1 / **g_bt_idle_finishes=0（兜底未误伤正常会话）**；
#     g_eof_run_m=3868、g_eof_v_state_m=3868 ⇒ $BS 帧解析正常、对端 poll 心跳在跑
#     （这 3868 次否决全部来自 TEST 前后的非 RECV 时段，逻辑自洽）。
#   两侧均已重新编译并烧录（ESP32 COM10 哈希校验通过；STM32 probe-rs download + reset）。
#   未验：真手机再发一次文件（需用户操作）。
#
# FLASH 1 644 792 B（78.41%），比第二十二版 +536 B。
# e2a06c3acc7670a25cbe1bee82a6d8b8515d104294001bb0e04d67f916bdd2c5  ymgui-h743.bin
# 5f8d52a3ae179696a9d1de12d98cc2dec9d646bcb79ad6a08d1ad0d39a328ebd  ymgui-h743.elf

# ============================================================================
# 第二十四版（2026-10-11）—— 真实手机路径打通；新增文件头魔数诊断
# ----------------------------------------------------------------------------
# 一、实测：蓝牙收文件**链路全通**（此前几轮失败都不是传输问题）
#   s_state=3(DONE) / s_recv=53316 / g_bt_bytes=53316 / chunks=27 /
#   err=0 / crc_bad=0 / fs_rc=0 / g_bt_done=1 / **g_bt_idle_finishes=1（兜底接住）**
#   g_spp_rx_m 累计 106632 = 53316×2（两次发送各一份）
#   ⇒ 手机连上 → 全收 → 落卡 → 兜底收尾 → 排队导入，全部正常。
#   唯一的失败点在图库导入，与蓝牙无关。
#
# 二、导入失败的真因：**用户发的是 PNG**
#   对卡上已有文件重放导入后读到
#     g_sniff_magic = 0x89504E47（89 50 4E 47 = "\x89PNG"）、g_sniff_bytes=8
#     g_img_rc = 4 (RC_NOT_BMP)
#   ⇒ 头既不是 FF D8 也不是 BM，是 PNG 魔数；固件只接了 BMP 与硬件 JPEG，
#     没有 PNG 解码器 ⇒ 必然失败。换 .bmp / .jpg 发应可成功（待用户复验）。
#
# 三、本次改动：src/img_store.c 新增 g_sniff_magic / g_sniff_bytes
#   sniff_image_kind() 改为读 8 字节（判定仍只用前 2 个），前 4 字节记成大端
#   g_sniff_magic、实读字节数记 g_sniff_bytes。
#   价值：裸流文件一律被命名为 btrecv.bin（原始后缀在对端就丢了），
#   只看 g_img_rc=4 根本不知道收到的是什么，把头字节打出来才能一眼分辨
#   （PNG / 有垃圾前缀 / 文件被截断）。
#
# 四、验收（已验）
#   两侧固件均已烧录；用"SWD 写 g_img_path + g_img_test=1"重放导入卡上已有
#   文件（无需重发），成功读出魔数 ⇒ 诊断通路可用。
#   未验：改发 .jpg 后能否成功进相册（需用户操作）。
#
# FLASH 1 644 840 B（78.41%），比第二十三版 +48 B。
# f4f604ff61b756ed1ee35944928c7bd21e6290f73d91ddf8de4d10462c1decda  ymgui-h743.bin
# a6abbcece97ef872c1c096c389ceaaf66faf3fbc2fa605baa7df3d959257c57e  ymgui-h743.elf

# ============================================================================
# 第二十五版（2026-10-11）—— 相册删除按钮（用户已确认设计稿后定稿）
# ----------------------------------------------------------------------------
# 一、底层：图库此前**只有查询、没有删除**（BoardGallery_* 只有 Count/Info/Pixels）
#   src/img_store.c/.h 新增：
#     · img_store_delete(slot)   —— 把该槽位 16 B 索引条目**写 0**
#     · img_store_next_valid(from)—— 从 from 起（回绕）找下一个有效槽位
#     · BoardGallery_Delete(slot, *next_valid)
#     · BoardGallery_Next(from)
#   ⚠ 为什么删除 = 写 0：有效性判据是 rd16(e)==IMG_MAGIC && (rd16(e+2)&IMG_FLAG_VALID)，
#     写 0 后两条都不成立 ⇒ 立即失效，且会被下次导入当作空位复用（分配空位同一判据）。
#   ⚠ 写完必须 qspi_enter_mmap()：qspi_write 退出映射后**不自恢复**，
#     indirect 模式下读 XIP 会触发精确 BusFault（2026-10-08 实测 CFSR=0x8200）。
#   ⚠ 不擦数据区（有意取舍）：空间账是 max(off+len)，删掉条目后那段数据不会被覆盖，
#     只是暂不回收；紧凑整理代价大、对 256 张/2 MB 的相册不划算。
#
# 二、UI：third_party/.../apps/gallery.c
#   底部单行 284×34 拆成两个 138 宽按钮：「下一张 >」+「删除」。
#   防误删：点「删除」→ 变红并显示「确认删除?」+ 提示「再点一次删除当前这张」；
#     再点才真删；点「下一张」即解除确认态。
#   ⚠ 顺手修了"下一张"的取模算法：原 (index+1)%total 在**删过图之后**会落在空槽上
#     （槽位号是物理槽号、不是"第几张"，删中间一张就出现空洞）⇒ 改用 BoardGallery_Next。
#
# 三、验收（已验，SWD 触发 g_img_del_req，无需人手点按钮）
#   写 g_img_del_req=0 删 slot 0 ⇒ g_img_del_rc=0、g_img_del_next=1；
#   XIP 直读：slot 0 条目全 0（已失效），slot 1 条目 47 49 01 00 00 30 00 00 … 一字未变
#     ⇒ 未误伤相邻槽位；删除后 XIP 仍可读 ⇒ 映射已正确恢复。
#   ⚠ 副作用：这次自验**真的删掉了图库里 slot 0 那张图**（96×64），已告知用户。
#
# FLASH 1 645 560 B（78.44%），比第二十四版 +720 B。
# --- 第二十五版（相册删除按钮）：已被第二十六版取代 ---
# 455b7a4ebbbbab826f179badd8b99598cd849f81a39d541c0100d0e81f02d39a  ymgui-h743.bin
